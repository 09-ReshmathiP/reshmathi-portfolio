# Copy this file to .env.local and fill in your own EmailJS credentials
# (create a free account at https://www.emailjs.com).
# Until these are set, the Contact form automatically falls back to a
# mailto: link, so it always works — this just upgrades it to send
# in-page without leaving the site.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
